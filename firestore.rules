rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMutualFriend(otherUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/friends/$(request.auth.uid)/accepted/$(otherUid))
        && exists(/databases/$(database)/documents/friends/$(otherUid)/accepted/$(request.auth.uid));
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function sharesStats(uid) {
      return userDoc(uid).shareStats == true;
    }

    function sharesListening(uid) {
      return userDoc(uid).shareListening == true;
    }

    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.lower() == name;
      allow delete: if isOwner(resource.data.uid);
      allow update: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isMutualFriend(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);

      match /sessions/{sessionId} {
        allow read: if isOwner(uid) || (isMutualFriend(uid) && sharesStats(uid));
        allow create, update, delete: if isOwner(uid);
      }

      match /public/stats {
        allow read: if isOwner(uid) || (isMutualFriend(uid) && sharesStats(uid));
        allow write: if isOwner(uid);
      }

      match /public/nowPlaying {
        allow read: if isOwner(uid) || (isMutualFriend(uid) && sharesListening(uid));
        allow write: if isOwner(uid);
      }

      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /friends/{uid}/accepted/{otherUid} {
      allow read: if isOwner(uid) || request.auth.uid == otherUid;
      // Owner can save their own friend list. The other person may also
      // write this doc when accepting a request (or retrying after a partial accept).
      allow create, update: if signedIn() && uid != otherUid && (
        isOwner(uid)
        || (
          request.auth.uid == otherUid
          && (
            exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid)/incoming/$(uid))
            || exists(/databases/$(database)/documents/friends/$(request.auth.uid)/accepted/$(uid))
          )
        )
      );
      allow delete: if isOwner(uid) || request.auth.uid == otherUid;
    }

    function canMessage(otherUid) {
      return signedIn() && otherUid is string && otherUid.size() > 0 && (
        isMutualFriend(otherUid)
        || exists(/databases/$(database)/documents/friends/$(request.auth.uid)/accepted/$(otherUid))
        || exists(/databases/$(database)/documents/friends/$(otherUid)/accepted/$(request.auth.uid))
      );
    }

    match /chats/{chatId} {
      function chatMembers() {
        return resource.data.members;
      }

      function otherChatMember(members) {
        return members[0] == request.auth.uid ? members[1] : members[0];
      }

      allow read: if signedIn() && request.auth.uid in chatMembers();
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && canMessage(otherChatMember(request.resource.data.members));
      allow update: if signedIn()
        && request.auth.uid in chatMembers()
        && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 400;
        allow update, delete: if false;
      }
    }

    match /friendRequests/{uid}/incoming/{fromUid} {
      allow read: if isOwner(uid) || request.auth.uid == fromUid;
      allow create: if signedIn() && request.auth.uid == fromUid && uid != fromUid;
      allow delete: if isOwner(uid) || request.auth.uid == fromUid;
      allow update: if false;
    }
  }
}
