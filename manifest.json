{
  "manifest_version": 3,
  "name": "Focus Buddy",
  "version": "0.1.0",
  "description": "A focus tracking companion.",
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": [
    "<all_urls>",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["sleepbunny.png", "angrybunny.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
