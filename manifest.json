{
  "manifest_version": 3,
  "name": "Focus Buddy",
  "version": "0.1.2",
  "description": "A focus tracking companion.",
  "key": "",
  "permissions": ["tabs", "storage", "alarms", "scripting", "identity"],
  "host_permissions": [
    "<all_urls>",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "logo.PNG"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "logo.PNG",
    "48": "logo.PNG",
    "128": "logo.PNG"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["overlay.js", "site-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "moon1.png",
        "moon2.png",
        "moon3.png",
        "moon4.png",
        "moon5.png",
        "moonbuddysprites/*/*",
        "cat.png",
        "cat2.png",
        "cat3.png",
        "cat4.png",
        "cat5.png",
        "cat6.png",
        "cat7.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
