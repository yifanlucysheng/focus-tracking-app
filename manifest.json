{
  "manifest_version": 3,
  "name": "Focus Buddy",
  "version": "0.1.0",
  "description": "A focus tracking companion.",
  "permissions": ["tabs", "storage", "alarms", "scripting", "identity"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "logo.PNG"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "logo.PNG",
    "48": "logo.PNG",
    "128": "logo.PNG"
  },
  "web_accessible_resources": [
    {
      "resources": ["sleepbunny.png", "angrybunny.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
